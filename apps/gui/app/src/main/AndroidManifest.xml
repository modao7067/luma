        <activity android:name="io.github.modao7067.luma.root.MainActivity" android:enableOnBackInvokedCallback="true" android:process=":root" android:theme="@style/RootTerminalTheme"/>
        <service android:name="io.github.modao7067.luma.root.ShellService" android:process=":root"/>
        <receiver android:name="io.github.modao7067.luma.gui.session.SessionWakeReceiver" android:exported="true" android:permission="android.permission.DUMP"/>
    </application>
</manifest>
