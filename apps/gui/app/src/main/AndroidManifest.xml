<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
    </queries>
    <application android:name="io.github.modao7067.luma.gui.LumaApplication" android:enableOnBackInvokedCallback="true" android:networkSecurityConfig="@xml/agent_network_security" android:appComponentFactory="io.github.modao7067.luma.LumaAppComponentFactory" tools:replace="android:appComponentFactory" android:label="Luma" android:theme="@style/AppTheme" android:icon="@mipmap/luma_launcher" android:roundIcon="@mipmap/luma_launcher" android:allowBackup="false" android:dataExtractionRules="@xml/agent_data_extraction" android:extractNativeLibs="true" android:hardwareAccelerated="true" android:supportsRtl="true">
        <provider android:name="io.github.modao7067.luma.TerminalArtifactProvider" android:authorities="${applicationId}.terminal-files" android:exported="false" android:grantUriPermissions="true"/>
