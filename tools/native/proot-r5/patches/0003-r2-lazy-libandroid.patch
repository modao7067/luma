+/*
+ * libandroid is loaded on first use rather than at process start.
+ *
+ * The platform declarations are used as-is (ASharedMemory_create returns int,
+ * ASharedMemory_getSize returns size_t); only the moment of resolving them
+ * changes.  The handle is opened explicitly instead of through RTLD_DEFAULT so
+ * that a symbol defined in this library or in the executable can never satisfy
+ * the lookup.  Resolution is done once under pthread_once and never reopens or
+ * closes the library.  When the platform library or a symbol is missing the
+ * original /dev/ashmem implementation below is used, which is a real
+ * implementation, not a success stub.
+ */
+#define ASHMEM_LIBANDROID "libandroid.so"
+
+static pthread_once_t ashmem_api_once = PTHREAD_ONCE_INIT;
+static int ashmem_api_state; /* 0 = unresolved, 1 = ready, -1 = unavailable */
+static int (*ashmem_api_create)(const char *, size_t);
+static size_t (*ashmem_api_get_size)(int);
+
+static void ashmem_api_load(void)
+{
+	void *handle = dlopen(ASHMEM_LIBANDROID, RTLD_NOW | RTLD_LOCAL);
+	if (handle == NULL) {
+		ashmem_api_state = -1;
+		return;
+	}
+
+	*(void **) (&ashmem_api_create) = dlsym(handle, "ASharedMemory_create");
+	*(void **) (&ashmem_api_get_size) = dlsym(handle, "ASharedMemory_getSize");
+	if (ashmem_api_create == NULL || ashmem_api_get_size == NULL) {
+		ashmem_api_state = -1;
+		return;
+	}
+	ashmem_api_state = 1;
+}
+
+static bool ashmem_api_ready(void)
+{
+#if defined(R2_FORCE_ASHMEM_FALLBACK)
+	/* Test-only switch: exercised by tests/adapter_contract.c to prove the
+	 * fallback path without lying about a successful platform load.  Never
+	 * defined in the shipped build. */
+	return false;
+#endif
+	pthread_once(&ashmem_api_once, ashmem_api_load);
+	return ashmem_api_state == 1;
+}
+
 static int ashmem_get_size_region(int fd)
 {
-#if __ANDROID_API__ >= 26
-	return ASharedMemory_getSize(fd);
-#else
+	if (ashmem_api_ready())
+		return (int) ashmem_api_get_size(fd);
+
 	return TEMP_FAILURE_RETRY(ioctl(fd, ASHMEM_GET_SIZE, NULL));
-#endif
 }
 
